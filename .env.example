# ==============================================================================
# CLOUDSCAPE NEXUS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your real credentials.
# The .env file is gitignored and should NEVER be committed to version control.
# ==============================================================================

# --- AWS Live Credentials (LIVE-AWS-01) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_ACCOUNT_ID=your-aws-account-id
AWS_DEFAULT_REGION=ap-south-1

# --- Azure Live Credentials (LIVE-AZ-01) ---
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# --- Neo4j Database ---
NEO4J_PASSWORD=Cloudscape2026!

# --- Execution Mode ---
# Set to LIVE for real cloud discovery, MOCK for local simulation
CLOUDSCAPE_EXECUTION_MODE=MOCK
